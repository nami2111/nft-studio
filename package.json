{
	"name": "gnstudio",
	"version": "0.5.5",
	"private": true,
	"description": "NFT collection studio for generating and managing NFT collections",
	"author": "aimsomnia",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "tsc --noEmit && vp build && npm run postbuild",
		"postbuild": "node scripts/remove-comments.js",
		"prepare": "svelte-kit sync",
		"preview": "vp preview",
		"check": "vp check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint",
		"format": "vp fmt . --write",
		"test": "vp test",
		"test:watch": "vp test watch",
		"test:coverage": "vp test run --coverage",
		"postinstall:copy-auth": "node -e \"require('fs').cpSync('node_modules/@junobuild/core/dist/workers/', './static/workers', {recursive: true});\"",
		"postinstall": "pnpm run postinstall:copy-auth",
		"verify-lockfile": "bash ./scripts/verify-lockfile.sh",
		"test:ci": "vp test run --reporter=junit --outdir .svelte-kit/test-results"
	},
	"dependencies": {
		"@junobuild/analytics": "^0.2.15",
		"@junobuild/core": "^5.4.0",
		"@junobuild/functions": "^0.9.0",
		"@neobr/svelte": "^2.1.0",
		"@zip.js/zip.js": "^2.8.36",
		"idb": "^8.0.3",
		"vite-plus": "^0.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@hugeicons/core-free-icons": "^4.2.3",
		"@hugeicons/svelte": "^1.1.4",
		"@junobuild/config": "^3.0.1",
		"@junobuild/vite-plugin": "^4.7.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.5",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.1.10",
		"dompurify": "^3.4.13",
		"jsdom": "^29.1.1",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.26",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.1.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.10.0"
}
